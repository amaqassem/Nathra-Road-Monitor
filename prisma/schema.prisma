// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// المواقع المراقبة (المنشآت/المبانئ)
model Site {
  id        String   @id @default(cuid())
  name      String
  nameEn    String
  city      String
  cityEn    String
  type      String   // صناعي / تجزئة / مدينة ذكية / رعاية صحية
  typeEn    String
  lat       Float
  lng       Float
  cameras   Camera[]
  alerts    Alert[]
  createdAt DateTime @default(now())
}

// الكاميرات
model Camera {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  status      String   // online / offline / maintenance
  resolution  String   // 1080p / 4K / 720p
  fps         Int
  model       String   // النموذج النشط
  modelEn     String
  zone        String   // المنطقة داخل الموقع
  zoneEn      String
  events24h   Int      // عدد أحداث آخر 24 ساعة
  lastEventAt DateTime?
  alerts      Alert[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// التنبيهات الأمنية
model Alert {
  id          String   @id @default(cuid())
  cameraId    String
  camera      Camera   @relation(fields: [cameraId], references: [id])
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id])
  type        String   // intrusion/crowd/suspicious/loitering/fight/fall/face/perimeter
  typeEn      String
  severity    String   // critical/high/medium/low
  status      String   // active/acknowledged/resolved
  description String
  descriptionEn String
  confidence  Int      // 0-100
  thumbnail   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// خطوط إنتاج الرؤية
model Pipeline {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  description String
  descriptionEn String
  stages      String   // مراحل الخط مفصولة بـ |
  stagesEn    String
  active      Boolean  @default(true)
  throughput  Int      // إطار/ث
  latency     Int      // مللي ثانية
  siteCount   Int
  createdAt   DateTime @default(now())
}
